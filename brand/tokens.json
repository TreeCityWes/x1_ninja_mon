{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "X1.Ninja Color Tokens",
  "source": "https://x1.ninja",
  "extracted": "2026-08-24",
  "colorScheme": "dark",
  "identity": {
    "ninja-void": { "hex": "#000000", "rgb": "0 0 0", "usage": "Logo canvas, deepest product background" },
    "ninja-navy": { "hex": "#003A93", "rgb": "0 58 147", "usage": "Logo X dark stop, ninja headband" },
    "ninja-blue": { "hex": "#0060AE", "rgb": "0 96 174", "usage": "Logo X mid stop, X1 wordmark" },
    "ninja-mid": { "hex": "#0078C0", "rgb": "0 120 192", "usage": "Logo X light stop" },
    "ninja-steel": { "hex": "#243030", "rgb": "36 48 48", "usage": "Ninja hood / mask" },
    "ninja-gold": { "hex": "#C9A227", "rgb": "201 162 39", "usage": "Katana tsuba accent only" }
  },
  "surfaces": {
    "bg-primary": { "hex": "#000000", "css": "--bg-primary", "usage": "App canvas" },
    "bg-chrome": { "hex": "#0A0A0F", "css": "theme-color", "usage": "Browser chrome / theme-color meta" },
    "bg-secondary": { "hex": "#0B0F14", "css": "--bg-secondary", "usage": "Sidebar, sticky headers, raised panels" },
    "bg-tertiary": { "hex": "#121821", "css": "--bg-tertiary", "usage": "Inset wells, logo rail, nested cards" },
    "bg-hover": { "hex": "#1A2332", "css": "--bg-hover", "usage": "Row / control hover" },
    "border-subtle": { "hex": "#1C2430", "css": "--border-subtle", "usage": "Default 1px dividers" },
    "border-bright": { "hex": "#263244", "css": "--border-bright", "usage": "Emphasized borders, table rules" }
  },
  "text": {
    "text-primary": { "hex": "#FFFFFF", "css": "--text-primary", "usage": "Headings, prices, primary labels", "contrastOnVoid": "21.0:1 AAA" },
    "text-secondary": { "hex": "#9AA4B2", "css": "--text-secondary", "usage": "Body, table values, helper copy", "contrastOnVoid": "8.33:1 AAA" },
    "text-muted": { "hex": "#768291", "css": "--text-muted", "usage": "Column headers, placeholders, meta", "contrastOnVoid": "5.37:1 AA" }
  },
  "accent": {
    "x1-blue": { "hex": "#00B8FF", "css": "--x1-blue", "usage": "Links, selected filters, focus rings, primary buttons, brand highlight", "contrastOnVoid": "9.30:1 AAA" }
  },
  "semantic": {
    "buy-green": { "hex": "#00FF9C", "css": "--buy-green", "usage": "Positive delta, buys, flash-up", "contrastOnVoid": "15.78:1 AAA" },
    "sell-red": { "hex": "#FF3355", "css": "--sell-red", "usage": "Negative delta, sells, flash-down", "contrastOnVoid": "5.86:1 AA" },
    "warn-yellow": { "hex": "#FFD166", "css": "--warn-yellow", "usage": "Caution, pending, highlighted metrics", "contrastOnVoid": "14.56:1 AAA" }
  },
  "type": {
    "sans": "Inter",
    "mono": "JetBrains Mono"
  },
  "doNot": [
    "White text on #00B8FF (2.26:1, fails WCAG)",
    "Logo navy (#003A93) as small UI text on black (fails contrast)",
    "Light theme derived from these tokens",
    "Warm grays or purple-black surfaces",
    "Neon #39FF14 as a product accent (site leftover, not brand)"
  ]
}
